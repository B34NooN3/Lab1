@model List<string>

<h2>Lista Autorów</h2>
<a asp-action="Create" style="display:inline-block; margin-bottom:15px; padding:5px 10px; background-color:#007bff; color:white; text-decoration:none; border-radius:4px;">Dodaj nowego autora</a>

<ul>
    @foreach (var author in Model)
    {
        <li>@author</li>
    }
</ul>