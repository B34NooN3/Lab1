@model BookStore.Web.Services.PagedResult<BookStore.Web.Models.Book>

<h2>Lista Książek</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Dodaj książkę</a>

<form method="get" asp-action="Index" class="mb-3">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Szukaj..." />
    <button type="submit" class="btn btn-secondary btn-sm">Szukaj</button>
</form>

<table class="table">
    <thead>
    <tr>
        <th>Tytuł</th>
        <th>Autor</th>
        <th>Rok</th>
        <th>Cena</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var b in Model.Items)
    {
        <partial name="_BookRow" model="b" />
    }
    </tbody>
</table>

<div class="mt-3">
    @for (var p = 1; p <= Model.TotalPages; p++)
    {
        <a asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" class="btn btn-outline-secondary btn-sm">@p</a>
    }
</div>